# PLAN TASK: 1 | STUDENT TASK PACK: Day 1 | EVIDENCE: ONB-01
# WHERE: template-service container image
# DO: use the X-Simulate-Delay header during dependency failure tests.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY suggest ./suggest

ENV PYTHONPATH=/app
EXPOSE 8001

CMD ["uvicorn", "suggest.main:app", "--host", "0.0.0.0", "--port", "8001"]
